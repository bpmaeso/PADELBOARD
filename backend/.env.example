# Copia este fichero a `.env` en el VPS (/opt/stacks/pocketbase/.env) y rellena
# con tus claves reales. El .env con claves NO se versiona (ver .gitignore).
#
# IMPORTANTE: tras editar el .env hay que RECREAR el contenedor para que
# lo relea (un `docker restart` NO recarga el env_file):
#   cd /opt/stacks/pocketbase && docker compose up -d --force-recreate
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Precio del pago único Pro. Opcionales: si no se ponen, por defecto 999 = 9,99 EUR.
# Cambiar el precio NO requiere tocar código, solo el .env + recrear contenedor.
PRO_PRICE_CENTS=999
PRO_CURRENCY=eur
